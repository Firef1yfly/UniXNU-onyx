diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -7,7 +7,7 @@ _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + (_Payload - _Head) /* Shim plus firmware, excludes appended FDT */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -17,11 +17,9 @@ _StackSize:
 #endif
 
 _Start:
-  /* Unconditionally use the appended DTB at _Payload + FD_SIZE.
-     The bootloader-supplied x0 points at its own FDT which lacks
-     linux,initrd-start, so force the DTB that ships in boot.img. */
-  ldr   x2, =FD_SIZE
-  add   x0, x1, x2
+  /* Preserve bootloader x0, including runtime memory and initrd fixups.
+     An appended static DTB is not a substitute for the runtime handoff.
+     Missing initrd must be diagnosed, not hidden by selecting stale FDT data. */
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
