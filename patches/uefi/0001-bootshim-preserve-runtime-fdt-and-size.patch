# onyx port 0001: BootShim preserves the bootloader's runtime FDT (x0)
#
# Scope: the ARM64 boot header's image size field covers the shim plus the
#   firmware (not the appended DTB), and _Start no longer overwrites x0 with
#   "appended DTB at _Payload + FD_SIZE". The bootloader's runtime FDT carries
#   the live memory map and initrd fixups, so it is the only correct handoff.
# Limits: this is one step of the BootShim rewrite. 0007 continues from this
#   file (overlap-safe copy, cache maintenance, .ltorg) and is the patch to read
#   for the complete transport. The appended-DTB fallback removal means a
#   bootloader that passes no FDT now fails visibly instead of booting stale
#   initrd addresses.
diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index aa72c1f..a506fa6 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -7,7 +7,7 @@ _StackBase:
   .quad FD_BASE         /* Text Offset */
 
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
+  .quad FD_SIZE + (_Payload - _Head) /* Shim plus firmware, excludes appended FDT */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -17,11 +17,9 @@ _StackSize:
 #endif
 
 _Start:
-  /* Unconditionally use the appended DTB at _Payload + FD_SIZE.
-     The bootloader-supplied x0 points at its own FDT which lacks
-     linux,initrd-start, so force the DTB that ships in boot.img. */
-  ldr   x2, =FD_SIZE
-  add   x0, x1, x2
+  /* Preserve bootloader x0, including runtime memory and initrd fixups.
+     An appended static DTB is not a substitute for the runtime handoff.
+     Missing initrd must be diagnosed, not hidden by selecting stale FDT data. */
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
