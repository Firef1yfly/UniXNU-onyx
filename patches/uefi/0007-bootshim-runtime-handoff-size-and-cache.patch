diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
index aa72c1f..3e557de 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -1,32 +1,59 @@
+/* Boot transport derived from UniXNU/uefi-sheng b303410c8e401fc9419ae65a024356ed09a438ef.
+ * Keep bootloader x0 unchanged: an appended stock DTB has stale initrd addresses.
+ */
+#if (FD_SIZE == 0) || ((FD_SIZE & 15) != 0)
+#error FD_SIZE must be a nonzero multiple of the 16-byte copy width
+#endif
+
 _Head:
-  adr   x1, _Payload    /* Set _Entry address */
-  b     _Start          /* Jump to the real code */
+  adr   x1, _Payload
+  b     _Start
 
 #if REQUIRES_KERNEL_HEADER == 1
 _StackBase:
-  .quad FD_BASE         /* Text Offset */
-
+  .quad FD_BASE
 _StackSize:
-  .quad FD_SIZE         /* Image Size */
-  .quad 0               /* Flags */
-  .quad 0               /* Reserved */
-  .quad 0               /* Reserved */
-  .quad 0               /* Reserved */
-  .ascii "ARM\x64"      /* ARM64 Magic */
-  .long 0               /* Reserved */
+  .quad FD_SIZE + (_Payload - _Head)
+  .quad 0
+  .quad 0
+  .quad 0
+  .quad 0
+  .ascii "ARM\x64"
+  .long 0
 #endif
 
 _Start:
-  /* Unconditionally use the appended DTB at _Payload + FD_SIZE.
-     The bootloader-supplied x0 points at its own FDT which lacks
-     linux,initrd-start, so force the DTB that ships in boot.img. */
-  ldr   x2, =FD_SIZE
-  add   x0, x1, x2
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
   beq   _Entry
-  ldr   x6,  =FD_SIZE
+  ldr   x6, =FD_SIZE
+
+  /* Overlap is resolved rather than refused: the bootloader may place the
+   * image anywhere, including below or inside the firmware destination.
+   * Copy backwards when the destination sits above the source, forwards
+   * otherwise; both keep the source valid for every load.
+   */
+  adds  x7, x4, x6
+  b.cs  _Dead
+  adds  x8, x5, x6
+  b.cs  _Dead
+  cmp   x5, x7
+  b.hs  _CopyLoop
+  cmp   x4, x8
+  b.hs  _CopyLoop
+
+  /* dst > src and dst < src + size: walk from the end. */
+  add   x4, x4, x6
+  add   x5, x5, x6
+
+_CopyBack:
+  ldp   x2, x3, [x4, #-16]!
+  stp   x2, x3, [x5, #-16]!
+  subs  x6, x6, #16
+  b.ne  _CopyBack
+  ldr   x5, =FD_BASE
+  b     _Entry
 
 _CopyLoop:
   ldp   x2, x3, [x4], #16
@@ -36,12 +63,34 @@ _CopyLoop:
   ldr   x5, =FD_BASE
 
 _Entry:
+  /* Make relocated instructions visible before branching to the new FD.
+   * CTR_EL0.DminLine is log2(words), not a byte count.
+   */
+  dsb   sy
+  mrs   x9, ctr_el0
+  ubfx  x9, x9, #16, #4
+  mov   x10, #4
+  lsl   x9, x10, x9
+  sub   x10, x9, #1
+  bic   x8, x5, x10
+  ldr   x7, =FD_SIZE
+  add   x7, x5, x7
+
+_CleanLoop:
+  dc    cvac, x8
+  add   x8, x8, x9
+  cmp   x8, x7
+  b.lo  _CleanLoop
+  dsb   sy
+  ic    iallu
+  dsb   sy
+  isb
   br    x5
 
 _Dead:
   b     _Dead
 
 .text
+.ltorg
 .align 4
-
 _Payload:
