+/* Host mocks for OnyxHandoff.c. Test-only. */
+#include "onyx_host_shim.h"
+#include <stdarg.h>
+#include <libfdt.h>
+
+EFI_MEMORY_REGION_DESCRIPTOR  gHostMap[32];
+UINT8                         gHostMapCount;
+
+VOID *
+OnyxHostMapBase (VOID)
+{
+  return (VOID *)gHostMap;
+}
+
+VOID
+OnyxHostDebug (
+  IN UINT32  Level,
+  IN CHAR8   *Format,
+  ...
+  )
+{
+  va_list  Args;
+
+  (VOID)Level;
+  va_start (Args, Format);
+  vprintf (Format, Args);
+  va_end (Args);
+  printf ("\n");
+}
+
+VOID
+GetMemoryMap (
+  OUT EFI_MEMORY_REGION_DESCRIPTOR  **MemoryDescriptor,
+  OUT UINT8                         *MemoryDescriptorCount
+  )
+{
+  *MemoryDescriptor      = gHostMap;
+  *MemoryDescriptorCount = gHostMapCount;
+}
+
+INT32
+FdtCheckHeader (
+  IN CONST VOID  *Fdt
+  )
+{
+  return fdt_check_header (Fdt);
+}
+
+INT32
+FdtPathOffset (
+  IN CONST VOID   *Fdt,
+  IN CONST CHAR8  *Path
+  )
+{
+  return fdt_path_offset (Fdt, Path);
+}
+
+CONST FDT_PROPERTY *
+FdtGetProperty (
+  IN CONST VOID   *Fdt,
+  IN INT32        NodeOffset,
+  IN CONST CHAR8  *Name,
+  IN INT32        *Length
+  )
+{
+  return (CONST FDT_PROPERTY *)fdt_get_property (Fdt, NodeOffset, Name, Length);
+}
+
+int
+AsciiStrCmp (
+  IN CONST CHAR8  *A,
+  IN CONST CHAR8  *B
+  )
+{
+  return strcmp (A, B);
+}
