+#!/usr/bin/env python3
+"""Compile the real BootShim, validate its ARM64 header and disassembly.
+
+These are host regressions, not evidence of execution at EL1/EL2 on onyx.
+"""
+import re
+import shutil
+import struct
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+BASE, SIZE = 0xA7100000, 0x300000
+
+
+@unittest.skipUnless(all(shutil.which(t) for t in ('clang', 'llvm-objcopy', 'llvm-objdump', 'llvm-nm')), 'LLVM tools required')
+class BootShimTests(unittest.TestCase):
+    def compile(self, header):
+        with tempfile.TemporaryDirectory() as directory:
+            temp = Path(directory)
+            obj, binary = temp/'shim.o', temp/'shim.bin'
+            subprocess.run(['clang', '--target=aarch64-none-elf', '-c', f'-DFD_BASE={BASE}',
+                            f'-DFD_SIZE={SIZE}', f'-DREQUIRES_KERNEL_HEADER={header}',
+                            str(ROOT/'BootShim/BootShim.S'), '-o', str(obj)], check=True, capture_output=True)
+            subprocess.run(['llvm-objcopy', '-O', 'binary', str(obj), str(binary)], check=True)
+            symbols = subprocess.check_output(['llvm-nm', '-n', str(obj)], text=True)
+            assembly = subprocess.check_output(['llvm-objdump', '-d', '--no-show-raw-insn', str(obj)], text=True)
+            payload = int(next(line.split()[0] for line in symbols.splitlines() if line.endswith(' _Payload')), 16)
+            return binary.read_bytes(), assembly, payload
+
+    def test_header_describes_shim_and_fd(self):
+        data, _, payload = self.compile(1)
+        self.assertEqual(data[56:60], b'ARM\x64')
+        self.assertEqual(struct.unpack_from('<QQ', data, 8), (BASE, len(data)+SIZE))
+        self.assertEqual(payload, len(data), 'literal pool must precede appended FD')
+
+    def test_entry_preserves_runtime_x0(self):
+        _, assembly, _ = self.compile(1)
+        instructions = [line.split(':',1)[1].strip() for line in assembly.splitlines()
+                        if re.match(r'^\s*[0-9a-f]+:\s', line)]
+        self.assertFalse(any(re.match(r'(?:mov|add|ldr|adr|sub)\s+x0\b', ins) for ins in instructions), assembly)
+
+    def test_relocated_instructions_are_published(self):
+        for header in (0, 1):
+            with self.subTest(header=header):
+                data, assembly, payload = self.compile(header)
+                self.assertIn('dc\tcvac', assembly)
+                self.assertIn('ic\tiallu', assembly)
+                self.assertIn('dsb\tsy', assembly)
+                self.assertIn('isb', assembly)
+                self.assertEqual(payload, len(data))
+
+    def test_copy_handles_overlapping_source_and_destination(self):
+        _, assembly, _ = self.compile(1)
+        body = assembly
+        # A destination inside the source must copy downwards from the end:
+        # the forward loop alone would overwrite the bytes it still has to read.
+        self.assertIn('<_CopyBack>', body)
+        self.assertIn('ldp\tx2, x3, [x4, #-0x10]!', body)
+        self.assertIn('b.hs', assembly[:assembly.index('<_CopyLoop>:')])
+        # The dead loop must stay unreachable for overlap: only on overflow.
+        self.assertNotIn('b.lo\t0x', assembly[:assembly.index('<_CopyLoop>:')])
+
+if __name__ == '__main__':
+    unittest.main()
