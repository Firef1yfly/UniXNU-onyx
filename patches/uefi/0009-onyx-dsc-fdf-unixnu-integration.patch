 [Components]
   #
@@ -91,6 +112,7 @@
   #
   # UniXNU boot manager stack
   #
+  UniXNUPkg/Driver/AdvancedLogDxe/AdvancedLogDxe.inf
   UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.inf
   UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf
   UniXNUPkg/Application/UniXNU/UniXNU.inf
@@ -101,4 +123,19 @@
   FatPkg/EnhancedFatDxe/Fat.inf
 
 [BuildOptions]
-  CLANGPDB:*_*_*_DLINK_FLAGS = /FILEALIGN:0x200
+  # /Brepro replaces the random CodeView PDB signature and PE timestamp with a
+  # content hash, so the same sources reproduce the same firmware volume. Each
+  # module class needs its own line: a class-specific rule in the shared
+  # SiliciumPkg.dsc.inc would otherwise override the generic one below.
+  CLANGPDB:*_*_*_DLINK_FLAGS = /FILEALIGN:0x1000 /Brepro
+
+# Opt in only on onyx; shared SEC keeps other boards' existing handoff path.
+[BuildOptions.common.EDKII.SEC]
+  *_CLANGPDB_*_DLINK_FLAGS = /ALIGN:0x1000 /FILEALIGN:0x1000 /Brepro
+  *_CLANGPDB_AARCH64_CC_FLAGS = -DONYX_FDT_HANDOFF=1
+
+[BuildOptions.common.EDKII.DXE_CORE, BuildOptions.common.EDKII.DXE_DRIVER, BuildOptions.common.EDKII.UEFI_DRIVER, BuildOptions.common.EDKII.UEFI_APPLICATION, BuildOptions.common.EDKII.MM_CORE_STANDALONE, BuildOptions.common.EDKII.MM_STANDALONE]
+  *_CLANGPDB_*_DLINK_FLAGS = /ALIGN:0x1000 /Brepro
+
+[BuildOptions.common.EDKII.DXE_RUNTIME_DRIVER]
+  *_CLANGPDB_*_DLINK_FLAGS = /ALIGN:0x10000 /Brepro
