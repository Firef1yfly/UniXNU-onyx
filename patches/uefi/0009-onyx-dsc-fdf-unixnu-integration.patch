diff --git a/Platforms/Xiaomi/onyxPkg/onyx.dsc b/Platforms/Xiaomi/onyxPkg/onyx.dsc
index 84c2790..a7fff34 100644
--- a/Platforms/Xiaomi/onyxPkg/onyx.dsc
+++ b/Platforms/Xiaomi/onyxPkg/onyx.dsc
@@ -28,6 +28,11 @@
 !include BonitoPkg/BonitoPkg.dsc.inc
 
 [PcdsFixedAtBuild]
+  #
+  # Bring-up: keep only error-level output so an exception dump stays on screen.
+  # The default level floods the console and pushes the exception header away.
+  #
+  gEfiMdePkgTokenSpaceGuid.PcdDebugPrintErrorLevel|0x80000000
   #
   # DDR Memory
   #
@@ -44,6 +49,8 @@
   #
   gUniXNUPkgTokenSpaceGuid.PcdUniXNUDebugLevel|0x00000040
   gUniXNUPkgTokenSpaceGuid.PcdUniXNUConfigPath|L"\\EFI\\UniXNU\\unixnu.toml"
+  gUniXNUPkgTokenSpaceGuid.PcdUniXNUDeviceModel|L"onyx"
+  gAdvLoggerPkgTokenSpaceGuid.PcdAdvancedLoggerPages|1024
 
   #
   # SMBIOS
@@ -57,8 +64,11 @@
   #
   # Simple Frame Buffer
   #
-  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth|1280
-  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight|2772
+  # Measured on the device: qcom,mdss-dsi-panel-width = 0x5a0,
+  # panel-height = 0xc80. The earlier 1280x2772 was not this board's panel, so
+  # every framebuffer write landed on a mismatched stride.
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth|1440
+  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight|3200
   gSiliciumPkgTokenSpaceGuid.PcdFrameBufferColorDepth|32
 
   #
@@ -81,6 +91,17 @@
   # UniXNU boot manager
   #
   UniXNULib|UniXNUPkg/Library/UniXNULib/UniXNULib.inf
+  FdtLib|MdePkg/Library/BaseFdtLib/BaseFdtLib.inf
+  AdvancedLoggerAccessLib|AdvLoggerPkg/Library/AdvancedLoggerAccessLib/AdvancedLoggerAccessLib.inf
+  AdvancedLoggerHdwPortLib|AdvLoggerPkg/Library/AdvancedLoggerHdwPortLibNull/AdvancedLoggerHdwPortLibNull.inf
+  AssertLib|AdvLoggerPkg/Library/AssertLib/AssertLib.inf
+  QrEncoderLib|MsGraphicsPkg/Library/QrEncoderLib/QrEncoderLib.inf
+
+# Bring-up draws DXE debug output on the framebuffer through the platform
+# SerialPortLib. Routing it into the Advanced Logger RAM buffer instead makes the
+# QR exporter the only reader, and that exporter needs a working menu, so a stall
+# between SEC and the menu leaves no observable output at all. AdvancedLogDxe
+# stays in the volume and will report "no log" until DebugLib is switched back.
 
 [Components]
   #
@@ -91,6 +112,8 @@
   #
   # UniXNU boot manager stack
   #
+  onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.inf
+  UniXNUPkg/Driver/AdvancedLogDxe/AdvancedLogDxe.inf
   UniXNUPkg/Driver/UniXNURamDiskDxe/UniXNURamDiskDxe.inf
   UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.inf
   UniXNUPkg/Application/UniXNU/UniXNU.inf
@@ -101,4 +124,19 @@
   FatPkg/EnhancedFatDxe/Fat.inf
 
 [BuildOptions]
-  CLANGPDB:*_*_*_DLINK_FLAGS = /FILEALIGN:0x200
+  # /Brepro replaces the random CodeView PDB signature and PE timestamp with a
+  # content hash, so the same sources reproduce the same firmware volume. Each
+  # module class needs its own line: a class-specific rule in the shared
+  # SiliciumPkg.dsc.inc would otherwise override the generic one below.
+  CLANGPDB:*_*_*_DLINK_FLAGS = /FILEALIGN:0x1000 /Brepro
+
+# Opt in only on onyx; shared SEC keeps other boards' existing handoff path.
+[BuildOptions.common.EDKII.SEC]
+  *_CLANGPDB_*_DLINK_FLAGS = /ALIGN:0x1000 /FILEALIGN:0x1000 /Brepro
+  *_CLANGPDB_AARCH64_CC_FLAGS = -DONYX_FDT_HANDOFF=1
+
+[BuildOptions.common.EDKII.DXE_CORE, BuildOptions.common.EDKII.DXE_DRIVER, BuildOptions.common.EDKII.UEFI_DRIVER, BuildOptions.common.EDKII.UEFI_APPLICATION, BuildOptions.common.EDKII.MM_CORE_STANDALONE, BuildOptions.common.EDKII.MM_STANDALONE]
+  *_CLANGPDB_*_DLINK_FLAGS = /ALIGN:0x1000 /Brepro
+
+[BuildOptions.common.EDKII.DXE_RUNTIME_DRIVER]
+  *_CLANGPDB_*_DLINK_FLAGS = /ALIGN:0x10000 /Brepro
diff --git a/Platforms/Xiaomi/onyxPkg/onyx.fdf b/Platforms/Xiaomi/onyxPkg/onyx.fdf
