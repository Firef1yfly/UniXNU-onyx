+
+typedef struct {
+  EFI_DEVICE_PATH_PROTOCOL  Header;
+  EFI_GUID                  FvNameGuid;
+} MEDIA_FW_VOL_FILEPATH_DEVICE_PATH;
+
+#define CONST  const
+#define STATIC static
+#define IN
+#define OUT
+#define EFIAPI
+#define TRUE   1
+#define FALSE  0
+
+#define EFI_SUCCESS               0ULL
+#define EFI_INVALID_PARAMETER     0x8000000000000002ULL
+#define EFI_UNSUPPORTED           0x8000000000000003ULL
+#define EFI_DEVICE_ERROR          0x8000000000000007ULL
+#define EFI_OUT_OF_RESOURCES      0x8000000000000009ULL
+#define EFI_NOT_FOUND             0x800000000000000EULL
+#define EFI_ALREADY_STARTED       0x8000000000000011ULL
+#define EFI_SECURITY_VIOLATION    0x800000000000001AULL
+#define EFI_ERROR(Status)         (((EFI_STATUS)(Status) & 0x8000000000000000ULL) != 0)
+
+#define ByProtocol                2
+#define EVT_NOTIFY_SIGNAL         0x00000200U
+#define TPL_CALLBACK              8
+#define LOAD_OPTION_ACTIVE        0x00000001U
+#define EFI_SECTION_PE32          0x10
+#define EFI_FV_FILETYPE_DRIVER    0x07
+#define EFI_BOOT_ORDER_VARIABLE_NAME  L"BootOrder"
+
+#define EFI_VARIABLE_NON_VOLATILE        0x00000001U
+#define EFI_VARIABLE_BOOTSERVICE_ACCESS  0x00000002U
+#define EFI_VARIABLE_RUNTIME_ACCESS      0x00000004U
+
+#define DEBUG_ERROR  0x80000000U
+#define DEBUG_WARN   0x00000002U
+#define DEBUG_INFO   0x00000040U
+#define DEBUG(Expression)  OnyxBootHostDebug Expression
+
+typedef VOID (EFIAPI *EFI_EVENT_NOTIFY)(IN EFI_EVENT Event, IN VOID *Context);
+
+typedef struct _EFI_FIRMWARE_VOLUME2_PROTOCOL {
+  EFI_STATUS (EFIAPI *ReadFile)(
+    struct _EFI_FIRMWARE_VOLUME2_PROTOCOL  *This,
+    CONST EFI_GUID                         *NameGuid,
+    VOID                                   **Buffer,
+    UINTN                                  *BufferSize,
+    EFI_FV_FILETYPE                        *FoundType,
+    EFI_FV_FILE_ATTRIBUTES                 *FileAttributes,
+    UINT32                                 *AuthenticationStatus
+    );
+  EFI_STATUS (EFIAPI *ReadSection)(
+    struct _EFI_FIRMWARE_VOLUME2_PROTOCOL  *This,
+    CONST EFI_GUID                         *NameGuid,
+    UINT32                                 SectionType,
+    UINTN                                  SectionInstance,
+    VOID                                   **Buffer,
+    UINTN                                  *BufferSize,
+    UINT32                                 *AuthenticationStatus
+    );
+} EFI_FIRMWARE_VOLUME2_PROTOCOL;
+
+typedef struct {
+  UINT32      Revision;
+  EFI_HANDLE  ParentHandle;
+  VOID        *SystemTable;
+  EFI_HANDLE  DeviceHandle;
+} EFI_LOADED_IMAGE_PROTOCOL;
+
+typedef struct {
+  EFI_STATUS (EFIAPI *HandleProtocol)(IN EFI_HANDLE Handle, IN CONST EFI_GUID *Protocol, OUT VOID **Interface);
+  EFI_STATUS (EFIAPI *LocateHandleBuffer)(
+    IN EFI_LOCATE_SEARCH_TYPE SearchType,
+    IN CONST EFI_GUID        *Protocol,
+    IN VOID                  *SearchKey,
+    OUT UINTN                *NoHandles,
+    OUT EFI_HANDLE           **Buffer
+    );
+  EFI_STATUS (EFIAPI *CreateEventEx)(
+    IN UINT32             Type,
+    IN EFI_TPL            NotifyTpl,
+    IN EFI_EVENT_NOTIFY   NotifyFunction,
+    IN CONST VOID         *NotifyContext,
+    IN CONST EFI_GUID     *EventGroup,
+    OUT EFI_EVENT         *Event
+    );
+  EFI_STATUS (EFIAPI *LoadImage)(
+    IN BOOLEAN                    BootPolicy,
+    IN EFI_HANDLE                 ParentImageHandle,
+    IN EFI_DEVICE_PATH_PROTOCOL   *DevicePath,
+    IN VOID                       *SourceBuffer,
+    IN UINTN                      SourceSize,
+    OUT EFI_HANDLE                *ImageHandle
+    );
+  EFI_STATUS (EFIAPI *StartImage)(IN EFI_HANDLE ImageHandle, OUT UINTN *ExitDataSize, OUT CHAR16 **ExitData);
+} EFI_BOOT_SERVICES;
+
+typedef struct {
+  EFI_STATUS (EFIAPI *SetVariable)(
+    IN CONST CHAR16    *VariableName,
+    IN CONST EFI_GUID  *VendorGuid,
+    IN UINT32          Attributes,
+    IN UINTN           DataSize,
+    IN VOID            *Data
+    );
+} EFI_RUNTIME_SERVICES;
+
+extern EFI_BOOT_SERVICES   *gBS;
+extern EFI_RUNTIME_SERVICES *gRT;
+extern EFI_HANDLE          gImageHandle;
+
+/* The mock owns the GUID objects the driver compares against. */
+extern EFI_GUID  gEfiGlobalVariableGuid;
+extern EFI_GUID  gEfiFirmwareVolume2ProtocolGuid;
+extern EFI_GUID  gEfiLoadedImageProtocolGuid;
+extern EFI_GUID  gEfiEndOfDxeEventGroupGuid;
+extern EFI_GUID  gEfiEventReadyToBootGuid;
+extern EFI_GUID  gMockApplicationFileGuid;
+
+/* PcdLib: the application file GUID is the only PCD the driver reads. */
+#define PcdUniXNUApplicationFile  (&gMockApplicationFileGuid)
+#define PcdGetPtr(Token)          ((VOID *)(Token))
+
+/* Library classes, implemented by onyx_boot_path_mock.c. */
+VOID                       EfiInitializeFwVolDevicepathNode (IN OUT MEDIA_FW_VOL_FILEPATH_DEVICE_PATH *Node, IN CONST EFI_GUID *NameGuid);
+EFI_DEVICE_PATH_PROTOCOL  *DevicePathFromHandle (IN EFI_HANDLE Handle);
+EFI_DEVICE_PATH_PROTOCOL  *AppendDevicePathNode (IN CONST EFI_DEVICE_PATH_PROTOCOL *DevicePath, IN CONST EFI_DEVICE_PATH_PROTOCOL *Node);
+UINTN                      GetDevicePathSize (IN CONST EFI_DEVICE_PATH_PROTOCOL *DevicePath);
+EFI_STATUS                 GetEfiGlobalVariable2 (IN CONST CHAR16 *Name, OUT VOID **Value, OUT UINTN *Size);
+UINTN                      UnicodeSPrint (OUT CHAR16 *Buffer, IN UINTN BufferSize, IN CONST CHAR16 *Format, ...);
+VOID                      *AllocatePool (IN UINTN Size);
+VOID                      *AllocateZeroPool (IN UINTN Size);
+VOID                       FreePool (IN VOID *Buffer);
+VOID                      *CopyMem (IN VOID *Destination, IN CONST VOID *Source, IN UINTN Length);
+INTN                       CompareMem (IN CONST VOID *Destination, IN CONST VOID *Source, IN UINTN Length);
+VOID                       WriteUnaligned32 (OUT UINT32 *Buffer, IN UINT32 Value);
+VOID                       WriteUnaligned16 (OUT UINT16 *Buffer, IN UINT16 Value);
+VOID                       OnyxBootHostDebug (IN UINT32 Level, IN CONST CHAR8 *Format, ...);
+
+#endif /* ONYX_BOOT_PATH_SHIM_H_ */
diff --git a/Tests/OnyxBootPath/test_onyx_boot_path.py b/Tests/OnyxBootPath/test_onyx_boot_path.py
new file mode 100644
index 0000000..5c670ef
--- /dev/null
+++ b/Tests/OnyxBootPath/test_onyx_boot_path.py
@@ -0,0 +1,226 @@
+#!/usr/bin/env python3
+"""Host tests for UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.c.
+
+The real driver source is compiled on the host against mock boot and runtime
+services (see onyx_boot_path_shim.h) and driven through ctypes. The firmware
+volume, its device path and the application image bytes are synthetic; nothing
+here is onyx hardware evidence and no EDK II build is involved.
+
+What is pinned here is the boot-path contract that BDS depends on:
+
+* the primary path (Boot#### + BootOrder) stays the primary path,
+* the direct-start fallback is armed only when that path cannot be trusted
+  (no volume device path, or a failed SetVariable),
+* the fallback starts the image exactly once, on ReadyToBoot, and never when
+  registration succeeded,
+* the fallback stands down when BootOrder turns out to list our own option
+  anyway, because BDS signals ReadyToBoot immediately before it starts one,
+* every branch reports through a DEBUG line with the ONYX-BOOT prefix.
+"""
+import ctypes
+import itertools
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+MU = HERE.parents[1]
+SOURCE = MU / "UniXNUPkg/Driver/UniXNUDxe/UniXNUDxe.c"
+
+EFI_SUCCESS = 0
+EFI_OUT_OF_RESOURCES = 0x8000000000000009
+EFI_NOT_FOUND = 0x800000000000000E
+EFI_DEVICE_ERROR = 0x8000000000000007
+
+PREFIX = "ONYX-BOOT: "
+
+
+def build_library(target: Path) -> Path:
+    command = ["clang", "-shared", "-fPIC", "-O1", "-g", "-Werror",
+               "-DONYX_BOOT_PATH_HOST", "-I", str(HERE),
+               "-include", str(HERE / "onyx_boot_path_shim.h"),
+               str(HERE / "onyx_boot_path_mock.c"), str(SOURCE),
+               "-o", str(target)]
+    try:
+        subprocess.run(command, check=True, capture_output=True, text=True)
+    except FileNotFoundError as error:
+        raise unittest.SkipTest(f"clang unavailable: {error}") from error
+    except subprocess.CalledProcessError as error:
+        raise AssertionError(f"host build failed:\n{error.stdout}\n{error.stderr}") from error
+    return target
+
+
+class BootPathTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.temp = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.temp.cleanup)
+        cls.dir = Path(cls.temp.name)
+        cls.library = build_library(cls.dir / "libonyxboot.so")
+        cls.serial = itertools.count()
+        cls.bindings = cls.load(cls.library)
+
+    @staticmethod
+    def load(path: Path):
+        lib = ctypes.CDLL(str(path))
+        lib.UniXNUDxeEntry.restype = ctypes.c_uint64
+        lib.UniXNUDxeEntry.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
+        lib.OnyxMockReset.restype = None
+        lib.OnyxMockReset.argtypes = []
+        lib.OnyxMockSignalEndOfDxe.restype = ctypes.c_ubyte
+        lib.OnyxMockSignalEndOfDxe.argtypes = []
+        lib.OnyxMockSignalReadyToBoot.restype = ctypes.c_ubyte
+        lib.OnyxMockSignalReadyToBoot.argtypes = []
+        lib.OnyxMockLogCount.restype = ctypes.c_uint64
+        lib.OnyxMockLogCount.argtypes = []
+        lib.OnyxMockLogLine.restype = ctypes.c_char_p
+        lib.OnyxMockLogLine.argtypes = [ctypes.c_uint64]
+        return lib
+
+    # -- helpers ----------------------------------------------------------
+    def setUp(self):
+        # The driver's fallback flags are image-static, exactly like in
+        # firmware where it runs once per boot. A fresh copy of the library
+        # per test gives every test a pristine image instead of ordering each
+        # other's state.
+        path = self.dir / f"libonyxboot_{next(self.serial)}.so"
+        shutil.copyfile(self.library, path)
+        self.lib = self.load(path)
+        self.lib.OnyxMockReset()
+
+    def set_flag(self, name: str, value: bool):
+        ctypes.c_ubyte.in_dll(self.lib, name).value = 1 if value else 0
+
+    def counter(self, name: str) -> int:
+        return ctypes.c_uint64.in_dll(self.lib, name).value
+
+    def log(self) -> list[str]:
+        return [self.lib.OnyxMockLogLine(index).decode() for index in range(self.lib.OnyxMockLogCount())]
+
+    def entry(self) -> int:
+        return self.lib.UniXNUDxeEntry(None, None)
+
+    def assert_prefixed(self):
+        """Every line the driver emits must carry the panel-readable prefix."""
+        lines = [line for line in self.log() if line]
+        self.assertTrue(lines, "the driver emitted no DEBUG output at all")
+        for line in lines:
+            self.assertTrue(line.startswith(PREFIX), f"unprefixed DEBUG line: {line!r}")
+
+    # -- (a) volume without a device path ---------------------------------
+    def test_volume_without_device_path_arms_the_fallback(self):
+        self.set_flag("gMockFvHasDevicePath", False)
+        self.assertEqual(self.entry(), EFI_SUCCESS)
+        self.assertEqual(self.counter("gMockSetVariableCount"), 0,
+                         "no Boot#### should be written when the volume has no device path")
+        self.assertEqual(self.counter("gMockStartImageCount"), 0,
+                         "the fallback must not start anything during dispatch")
+        self.assertTrue(any("no device path" in line for line in self.log()), self.log())
+        self.assert_prefixed()
+
+        self.assertTrue(self.lib.OnyxMockSignalReadyToBoot())
+        self.assertEqual(self.counter("gMockLoadImageCount"), 1)
+        self.assertEqual(self.counter("gMockStartImageCount"), 1)
+        self.assert_prefixed()
+
+    # -- (b) SetVariable failures -----------------------------------------
+    def test_boot_option_write_failure_arms_the_fallback(self):
+        self.set_flag("gMockFailBootOption", True)
+        self.assertEqual(self.entry(), EFI_SUCCESS,
+                         "a failed Boot#### write must not fail the driver, or the fallback is unloaded")
+        self.assertEqual(self.counter("gMockSetVariableCount"), 1,
+                         "BootOrder must not be written when Boot#### failed")
+        self.assertTrue(any("cannot write Boot" in line for line in self.log()), self.log())
+
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockStartImageCount"), 1)
+        self.assert_prefixed()
+
+    def test_boot_order_write_failure_arms_the_fallback(self):
+        self.set_flag("gMockFailBootOrder", True)
+        self.assertEqual(self.entry(), EFI_SUCCESS)
+        self.assertEqual(self.counter("gMockSetVariableCount"), 2)
+        self.assertTrue(any("BootOrder" in line and "fallback armed" in line for line in self.log()), self.log())
+
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockStartImageCount"), 1)
+
+    def test_fallback_stands_down_when_boot_order_lists_our_option(self):
+        """A failed BootOrder write does not prove BDS will not boot us.
+
+        The option may already have been in BootOrder (this driver reuses an
+        identical Boot####). BDS signals ReadyToBoot right before it starts the
+        option, so starting here as well would run the application twice.
+        """
+        self.set_flag("gMockFailBootOrder", True)
+        self.set_flag("gMockBootOrderReportsOption", True)
+        self.assertEqual(self.entry(), EFI_SUCCESS)
+
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockStartImageCount"), 0,
+                         "the fallback must not start an option BDS is about to start")
+        self.assertTrue(any("fallback disarmed" in line for line in self.log()), self.log())
+        self.assert_prefixed()
+
+        # and it stays stood down: a second ReadyToBoot changes nothing
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockStartImageCount"), 0)
+
+    # -- (c) exactly once, however often the events fire ------------------
+    def test_fallback_starts_exactly_once(self):
+        self.set_flag("gMockFvHasDevicePath", False)
+        self.entry()
+        for _ in range(2):
+            self.lib.OnyxMockSignalEndOfDxe()
+            self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockLoadImageCount"), 1)
+        self.assertEqual(self.counter("gMockStartImageCount"), 1)
+        self.assertTrue(any("already ran" in line for line in self.log()), self.log())
+
+    # -- (d) the success path never arms the fallback ---------------------
+    def test_successful_registration_never_starts_the_application(self):
+        self.assertEqual(self.entry(), EFI_SUCCESS)
+        self.assertEqual(self.counter("gMockSetVariableCount"), 2,
+                         "Boot#### and BootOrder should both be written")
+        self.assertFalse(self.lib.OnyxMockSignalEndOfDxe(),
+                         "the success path must not hook EndOfDxe at all")
+        self.assertFalse(self.lib.OnyxMockSignalReadyToBoot(),
+                         "the success path must not hook ReadyToBoot at all")
+        self.assertEqual(self.counter("gMockLoadImageCount"), 0)
+        self.assertEqual(self.counter("gMockStartImageCount"), 0)
+        self.assertFalse(any("fallback:" in line for line in self.log()),
+                         f"the fallback took an action after a successful registration: {self.log()}")
+        self.assertTrue(any("fallback not armed" in line for line in self.log()), self.log())
+        self.assert_prefixed()
+
+    # -- the fallback loads what the FV holds -----------------------------
+    def test_fallback_loads_the_pe32_section_from_the_volume(self):
+        self.set_flag("gMockFvHasDevicePath", False)
+        self.entry()
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockReadSectionCount"), 1,
+                         "the fallback must read the PE32 section through the FV protocol")
+        self.assertEqual(ctypes.c_ubyte.in_dll(self.lib, "gMockLoadImageSawImage").value, 1,
+                         "LoadImage must receive exactly the bytes ReadSection returned")
+
+    def test_fallback_reports_a_start_failure(self):
+        self.set_flag("gMockFvHasDevicePath", False)
+        self.entry()
+        ctypes.c_uint64.in_dll(self.lib, "gMockStartImageStatus").value = EFI_DEVICE_ERROR
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertTrue(any("finished" in line and "0x8000000000000007" in line for line in self.log()), self.log())
+
+    # -- nothing to load --------------------------------------------------
+    def test_missing_application_is_reported_and_not_started(self):
+        self.set_flag("gMockApplicationInFv", False)
+        self.assertEqual(self.entry(), EFI_NOT_FOUND)
+        self.lib.OnyxMockSignalReadyToBoot()
+        self.assertEqual(self.counter("gMockStartImageCount"), 0)
+        self.assertTrue(any("in no firmware volume" in line for line in self.log()), self.log())
+        self.assert_prefixed()
+
+
+if __name__ == "__main__":
+    unittest.main()
