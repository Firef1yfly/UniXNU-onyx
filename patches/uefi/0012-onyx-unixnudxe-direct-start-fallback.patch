   }
 
   Option = BuildLoadOption (Path, &OptionSize);
   FreePool (Path);
   if (Option == NULL) {
-    return EFI_OUT_OF_RESOURCES;
+    Status = EFI_OUT_OF_RESOURCES;
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "cannot build the Boot#### value: %r\n", Status));
