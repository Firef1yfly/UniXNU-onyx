+STATIC
+VOID
+EFIAPI
+OnyxBootEndOfDxeNotify (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  //
+  // EndOfDxe is signalled inside PlatformBootManagerBeforeConsole, before the
+  // platform registers its own default boot options, so it only records the
+  // armed state. Starting the application there would race that registration
+  // and would run before console connect.
+  //
+  DEBUG ((
+    DEBUG_ERROR,
+    ONYX_BOOT_PREFIX "EndOfDxe, fallback %a: %r\n",
+    (mFallbackArmed && !mFallbackRan) ? "armed, waiting for ReadyToBoot" : "not needed",
+    EFI_SUCCESS
+    ));
+}
+
+STATIC
+BOOLEAN
+BootOrderHasOption (
+  IN UINT16  Number
+  )
+{
+  UINT16   *Order;
+  UINTN    OrderSize;
+  UINTN    Index;
+  BOOLEAN  Found;
+
+  Order     = NULL;
+  OrderSize = 0;
+  if (EFI_ERROR (GetEfiGlobalVariable2 (EFI_BOOT_ORDER_VARIABLE_NAME, (VOID **)&Order, &OrderSize)) ||
+      (Order == NULL))
+  {
+    return FALSE;
+  }
+
+  Found = FALSE;
+  for (Index = 0; (Index < OrderSize / sizeof (UINT16)) && !Found; Index++) {
+    Found = (Order[Index] == Number);
+  }
+
+  FreePool (Order);
+  return Found;
+}
+
+STATIC
+VOID
+EFIAPI
+OnyxBootReadyToBootNotify (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS  Status;
+
+  if (!mFallbackArmed) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "ReadyToBoot, no fallback armed, BDS owns the boot: %r\n", EFI_SUCCESS));
+    return;
+  }
+
+  if (mFallbackRan) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "ReadyToBoot signalled again, fallback already ran: %r\n", EFI_ALREADY_STARTED));
+    return;
+  }
+
+  //
+  // BDS signals ReadyToBoot itself, immediately before it would start the boot
+  // option, so this is the last moment where "who starts the application" can
+  // still be decided. A failed BootOrder write does not prove BDS will not boot
+  // us: the option may already have been in BootOrder (this driver reuses an
+  // identical Boot####). Starting here as well would run the application twice,
+  // so look at what BDS is actually going to do.
+  //
+  if (mFallbackNumberValid && BootOrderHasOption (mFallbackNumber)) {
+    mFallbackRan = TRUE;
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "Boot%04x is in BootOrder after all, BDS starts it, fallback disarmed: %r\n", mFallbackNumber, EFI_SUCCESS));
+    return;
+  }
+
+  //
+  // Set before starting: a nested or repeated signal must not start twice.
+  //
+  mFallbackRan = TRUE;
+  Status       = StartApplicationFromVolume (mFallbackVolume, mFallbackReason);
+  DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "fallback direct start finished: %r\n", Status));
+}
+
+//
+// Arm the direct start. Two event hooks, one action: EndOfDxe is logged for
+// the panel, ReadyToBoot performs the start. Both are signalled once per boot
+// by the DXE core/BDS; mFallbackRan makes repeats harmless.
+//
+STATIC
+VOID
+ArmFallback (
+  IN EFI_HANDLE   VolumeHandle,
+  IN CONST CHAR8  *Reason
+  )
+{
+  EFI_STATUS  Status;
+  EFI_EVENT   Event;
+
+  mFallbackArmed  = TRUE;
+  mFallbackVolume = VolumeHandle;
+  mFallbackReason = Reason;
+
+  Event  = NULL;
+  Status = gBS->CreateEventEx (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  OnyxBootEndOfDxeNotify,
+                  NULL,
+                  &gEfiEndOfDxeEventGroupGuid,
+                  &Event
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "cannot hook EndOfDxe, fallback will rely on ReadyToBoot: %r\n", Status));
+  }
+
+  Event  = NULL;
+  Status = gBS->CreateEventEx (
+                  EVT_NOTIFY_SIGNAL,
+                  TPL_CALLBACK,
+                  OnyxBootReadyToBootNotify,
+                  NULL,
+                  &gEfiEventReadyToBootGuid,
+                  &Event
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "cannot hook ReadyToBoot, fallback cannot run: %r\n", Status));
+    return;
+  }
+
+  DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "fallback armed (%a), will start the application at ReadyToBoot: %r\n", Reason, EFI_SUCCESS));
 }
 
