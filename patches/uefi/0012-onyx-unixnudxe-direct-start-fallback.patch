 STATIC CONST CHAR16  mDescription[]    = L"UniXNU";
 
+//
+// Fallback state. mFallbackArmed stays FALSE whenever Boot#### and BootOrder
+// were both written; mFallbackRan makes the direct start happen at most once
+// even if a signalled event group is signalled again.
+//
+STATIC BOOLEAN      mFallbackArmed   = FALSE;
+STATIC BOOLEAN      mFallbackRan     = FALSE;
+STATIC EFI_HANDLE   mFallbackVolume  = NULL;
+STATIC CONST CHAR8  *mFallbackReason = "primary path";
+
+//
+// The Boot#### number this driver selected. It is re-checked against BootOrder
+// right before the fallback would start anything: a run where the option was
+// already registered but a later write failed must not start the application
+// while BDS is about to start the very same option.
+//
+STATIC UINT16   mFallbackNumber      = 0;
+STATIC BOOLEAN  mFallbackNumberValid = FALSE;
