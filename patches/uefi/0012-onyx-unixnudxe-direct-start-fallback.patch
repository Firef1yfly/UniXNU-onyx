 #include <Protocol/FirmwareVolume2.h>
 #include <Protocol/LoadedImage.h>
+#endif
 
 #define OPTION_ATTRIBUTES  (EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS)
 
+//
+// Every decision this driver makes is reported through DEBUG at ERROR level:
+// the platform produces no console output (ConOut renders nothing on this
+// board) but its SerialPortLib draws DEBUG text into the framebuffer, so this
+// prefix is the only readable channel during bring-up. Keep it stable.
+//
+#define ONYX_BOOT_PREFIX  "ONYX-BOOT: "
+
 //
 // Optional data of the boot option; the application treats it as "started
 // by firmware". Keep in sync with UniXNU.c.
@@ -35,6 +74,25 @@
