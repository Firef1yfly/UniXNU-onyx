+//
+// Read the application's PE32 section out of the volume, load it and start it.
+//
+STATIC
+EFI_STATUS
+StartApplicationFromVolume (
+  IN EFI_HANDLE   VolumeHandle,
+  IN CONST CHAR8  *Reason
+  )
+{
+  EFI_FIRMWARE_VOLUME2_PROTOCOL  *Fv;
+  CONST EFI_GUID                 *File;
+  VOID                           *Image;
+  UINTN                          ImageSize;
+  UINT32                         AuthStatus;
+  EFI_HANDLE                     Application;
+  EFI_STATUS                     Status;
+
+  File        = (CONST EFI_GUID *)PcdGetPtr (PcdUniXNUApplicationFile);
+  Fv          = NULL;
+  Image       = NULL;
+  ImageSize   = 0;
+  AuthStatus  = 0;
+  Application = NULL;
+
+  Status = gBS->HandleProtocol (VolumeHandle, &gEfiFirmwareVolume2ProtocolGuid, (VOID **)&Fv);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "fallback: no FirmwareVolume2 on the application volume (%a): %r\n", Reason, Status));
+    return Status;
   }
 
-  EfiInitializeFwVolDevicepathNode (&Node, File);
-  return AppendDevicePathNode (DevicePathFromHandle (Fv), (EFI_DEVICE_PATH_PROTOCOL *)&Node);
+  Status = Fv->ReadSection (Fv, File, EFI_SECTION_PE32, 0, &Image, &ImageSize, &AuthStatus);
+  if (EFI_ERROR (Status) || (Image == NULL) || (ImageSize == 0)) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "fallback: cannot read the %g PE32 section (%a): %r\n", File, Reason, Status));
+    return EFI_ERROR (Status) ? Status : EFI_NOT_FOUND;
+  }
+
+  Status = gBS->LoadImage (TRUE, gImageHandle, NULL, Image, ImageSize, &Application);
+  FreePool (Image);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "fallback: LoadImage of %g from its volume failed (%a): %r\n", File, Reason, Status));
+    return Status;
+  }
+
+  DEBUG ((DEBUG_ERROR, ONYX_BOOT_PREFIX "fallback: starting %g directly from its firmware volume (%a): %r\n", File, Reason, EFI_SUCCESS));
+  Status = gBS->StartImage (Application, NULL, NULL);
+  return Status;
+}
