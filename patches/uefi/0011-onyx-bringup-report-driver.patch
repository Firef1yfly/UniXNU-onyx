+[Defines]
+  INF_VERSION                    = 0x00010005
+  BASE_NAME                      = OnyxBringupReportDxe
+  FILE_GUID                      = 4E1A7C22-3E4B-4B0F-9B62-0E3D0A1C7F58
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = OnyxBringupReportEntry
+
+[Sources]
+  OnyxBringupReportDxe.c
+
