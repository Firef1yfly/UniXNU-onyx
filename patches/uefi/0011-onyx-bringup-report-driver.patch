diff --git a/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c b/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c
new file mode 100644
index 0000000..1f35933
--- /dev/null
+++ b/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c
@@ -0,0 +1,165 @@
+/** @file
+  Bring-up report: why does BDS find nothing to boot?
+
+  The console is usable in DXE (BDS itself prints to it), but a driver that runs
+  before GraphicsConsole binds sees the null console and prints into nothing.
+  This driver therefore connects controllers until ConOut reports a real mode,
+  prints the boot-option state that decides whether BDS boots UniXNU, and halts
+  so the text stays on screen.
+
+  Diagnostic build only.
+
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+
+#include <Guid/GlobalVariable.h>
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/HobLib.h>
+#include <Library/PrintLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Protocol/FirmwareVolume2.h>
+#include <Protocol/GraphicsOutput.h>
+
+STATIC CONST EFI_GUID  mEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
+//
+// Connect every controller once per round until the console has a real mode.
+//
+STATIC
+BOOLEAN
+WaitForConsole (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  UINTN       Index;
+  UINTN       Round;
+
+  for (Round = 0; Round < 50; Round++) {
+    if ((gST->ConOut != NULL) && (gST->ConOut->Mode != NULL) && (gST->ConOut->Mode->Mode >= 0)) {
+      return TRUE;
+    }
+
+    Status = gBS->LocateHandleBuffer (ByProtocol, NULL, NULL, &Count, &Handles);
+    if (!EFI_ERROR (Status)) {
+      for (Index = 0; Index < Count; Index++) {
+        gBS->ConnectController (Handles[Index], NULL, NULL, TRUE);
+      }
+
+      FreePool (Handles);
+    }
+
+    gBS->Stall (100000);
+  }
+
+  return (gST->ConOut != NULL) && (gST->ConOut->Mode != NULL) && (gST->ConOut->Mode->Mode >= 0);
+}
+
+STATIC
+VOID
+ReportBootOptions (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINT16      *Order;
+  UINTN       OrderSize;
+  UINTN       Index;
+  CHAR16      Name[9];
+  VOID        *Value;
+  UINTN       ValueSize;
+
+  Order     = NULL;
+  OrderSize = 0;
+  Status    = gRT->GetVariable (L"BootOrder", &gEfiGlobalVariableGuid, NULL, &OrderSize, NULL);
+  if (Status == EFI_BUFFER_TOO_SMALL) {
+    Order = AllocatePool (OrderSize);
+    if (Order != NULL) {
+      Status = gRT->GetVariable (L"BootOrder", &gEfiGlobalVariableGuid, NULL, &OrderSize, Order);
+    }
+  }
+
+  if (EFI_ERROR (Status) || (Order == NULL)) {
+    Print (L"  BootOrder: unavailable (%r)\r\n", Status);
+  } else {
+    Print (L"  BootOrder: %u entries\r\n", (UINT32)(OrderSize / sizeof (UINT16)));
+    for (Index = 0; Index < OrderSize / sizeof (UINT16); Index++) {
+      UnicodeSPrint (Name, sizeof (Name), L"Boot%04x", Order[Index]);
+      Value     = NULL;
+      ValueSize = 0;
+      Status    = gRT->GetVariable (Name, &gEfiGlobalVariableGuid, NULL, &ValueSize, NULL);
+      if (Status == EFI_BUFFER_TOO_SMALL) {
+        Value = AllocatePool (ValueSize);
+        if (Value != NULL) {
+          Status = gRT->GetVariable (Name, &gEfiGlobalVariableGuid, NULL, &ValueSize, Value);
+        }
+      }
+
+      Print (L"    %s: %u bytes, %r\r\n", Name, (UINT32)ValueSize, Status);
+      if (Value != NULL) {
+        FreePool (Value);
+      }
+    }
+
+    FreePool (Order);
+  }
+}
+
+STATIC
+VOID
+ReportEnvironment (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  VOID        *Hob;
+
+  Hob = GetFirstGuidHob (&mEntryArgHobGuid);
+  Print (L"  handoff HOB: %s\r\n", (Hob == NULL) ? L"absent" : L"present");
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiFirmwareVolume2ProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    Print (L"  firmware volumes: %r\r\n", Status);
+  } else {
+    Print (L"  firmware volumes: %u\r\n", (UINT32)Count);
+    FreePool (Handles);
+  }
+
+  ReportBootOptions ();
+}
+
+EFI_STATUS
+EFIAPI
+OnyxBringupReportEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  if (WaitForConsole ()) {
+    gST->ConOut->ClearScreen (gST->ConOut);
+  }
+
+  Print (L"\r\n=== onyx bring-up report ===\r\n");
+  Print (L"console mode %d, %ux%u\r\n",
+         (INT32)gST->ConOut->Mode->Mode,
+         (UINT32)gST->ConOut->Mode->CursorColumn,
+         (UINT32)gST->ConOut->Mode->CursorRow);
+  ReportEnvironment ();
+  Print (L"=== halting; power cycle to continue ===\r\n");
+
+  CpuDeadLoop ();
+  return EFI_SUCCESS;
+}
