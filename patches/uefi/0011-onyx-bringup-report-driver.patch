diff --git a/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c b/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c
new file mode 100644
index 0000000..98d944a
--- /dev/null
+++ b/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c
@@ -0,0 +1,156 @@
+/** @file
+  Bring-up report: print the boot-option state that decides what BDS boots.
+
+  ConOut on this board renders nothing (the graphical console path does not reach
+  the panel), while DEBUG output does appear because the platform SerialPortLib
+  draws it into the framebuffer. The report therefore uses DEBUG at ERROR level,
+  which the platform debug level cannot filter out, and then halts so the text
+  stays readable.
+
+  Diagnostic build only.
+
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+
+#include <Guid/GlobalVariable.h>
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/DevicePathLib.h>
+#include <Library/HobLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PcdLib.h>
+#include <Library/PrintLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Protocol/FirmwareVolume2.h>
+
+STATIC CONST EFI_GUID  mEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
+STATIC
+VOID
+ReportBootOptions (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINT16      *Order;
+  UINTN       OrderSize;
+  UINTN       Index;
+  CHAR16      Name[9];
+  VOID        *Value;
+  UINTN       ValueSize;
+
+  Order     = NULL;
+  OrderSize = 0;
+  Status    = gRT->GetVariable (L"BootOrder", &gEfiGlobalVariableGuid, NULL, &OrderSize, NULL);
+  if (Status == EFI_BUFFER_TOO_SMALL) {
+    Order = AllocatePool (OrderSize);
+    if (Order != NULL) {
+      Status = gRT->GetVariable (L"BootOrder", &gEfiGlobalVariableGuid, NULL, &OrderSize, Order);
+    }
+  }
+
+  if (EFI_ERROR (Status) || (Order == NULL)) {
+    DEBUG ((DEBUG_ERROR, "ONYX: BootOrder is unavailable (%r)\n", Status));
+    return;
+  }
+
+  DEBUG ((DEBUG_ERROR, "ONYX: BootOrder has %u entries\n", (UINT32)(OrderSize / sizeof (UINT16))));
+  for (Index = 0; Index < OrderSize / sizeof (UINT16); Index++) {
+    UnicodeSPrint (Name, sizeof (Name), L"Boot%04x", Order[Index]);
+    Value     = NULL;
+    ValueSize = 0;
+    Status    = gRT->GetVariable (Name, &gEfiGlobalVariableGuid, NULL, &ValueSize, NULL);
+    if (Status == EFI_BUFFER_TOO_SMALL) {
+      Value = AllocatePool (ValueSize);
+      if (Value != NULL) {
+        Status = gRT->GetVariable (Name, &gEfiGlobalVariableGuid, NULL, &ValueSize, Value);
+      }
+    }
+
+    DEBUG ((DEBUG_ERROR, "ONYX:   entry %u: %u bytes, %r\n",
+            (UINT32)Index, (UINT32)ValueSize, Status));
+    if (Value != NULL) {
+      FreePool (Value);
+    }
+  }
+
+  FreePool (Order);
+}
+
+STATIC
+VOID
+ReportEnvironment (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  UINTN       Index;
+  VOID        *Hob;
+
+  Hob = GetFirstGuidHob (&mEntryArgHobGuid);
+  DEBUG ((DEBUG_ERROR, "ONYX: handoff HOB: %a\n", (Hob == NULL) ? "absent" : "present"));
+
+  //
+  // Mirror UniXNUDxe: it can only register a boot option when a firmware volume
+  // carries a device path and holds the application file.
+  //
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiFirmwareVolume2ProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ONYX: firmware volumes: %r\n", Status));
+    return;
+  }
+
+  {
+    UINTN  WithPath = 0;
+    UINTN  WithApp  = 0;
+
+    for (Index = 0; Index < Count; Index++) {
+      EFI_FIRMWARE_VOLUME2_PROTOCOL  *Fv;
+      EFI_FV_FILETYPE                Type;
+      EFI_FV_FILE_ATTRIBUTES         Attributes;
+      UINT32                         AuthStatus;
+      UINTN                          Size;
+
+      if (DevicePathFromHandle (Handles[Index]) != NULL) {
+        WithPath++;
+      }
+
+      if (!EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiFirmwareVolume2ProtocolGuid, (VOID **)&Fv)) &&
+          !EFI_ERROR (Fv->ReadFile (Fv, (CONST EFI_GUID *)PcdGetPtr (PcdUniXNUApplicationFile),
+                                    NULL, &Size, &Type, &Attributes, &AuthStatus)))
+      {
+        WithApp++;
+      }
+    }
+
+    DEBUG ((DEBUG_ERROR, "ONYX: firmware volumes: %u, %u with a device path\n",
+            (UINT32)Count, (UINT32)WithPath));
+    DEBUG ((DEBUG_ERROR, "ONYX: volumes holding UniXNU.efi: %u\n", (UINT32)WithApp));
+  }
+
+  FreePool (Handles);
+  ReportBootOptions ();
+}
+
+EFI_STATUS
+EFIAPI
+OnyxBringupReportEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  DEBUG ((DEBUG_ERROR, "\nONYX: === bring-up report ===\n"));
+  ReportEnvironment ();
+  DEBUG ((DEBUG_ERROR, "ONYX: === halting; power cycle to continue ===\n"));
+
+  CpuDeadLoop ();
+  return EFI_SUCCESS;
+}
