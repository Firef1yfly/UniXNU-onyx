diff --git a/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c b/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c
new file mode 100644
index 0000000..390fb21
--- /dev/null
+++ b/Platforms/Xiaomi/onyxPkg/Drivers/OnyxBringupReportDxe/OnyxBringupReportDxe.c
@@ -0,0 +1,172 @@
+/** @file
+  Bring-up report: paint checkpoints straight into the GOP framebuffer.
+
+  ConOut is not reliable this early on onyx — a driver that clears the screen and
+  then prints can leave a blank panel with no way to tell text rendering from a
+  hang. This driver therefore writes pixels itself: a background colour encodes
+  the furthest checkpoint reached, and one bar per checkpoint confirms the count.
+  It needs no font, no console binding and no delay in the boot path.
+
+  Diagnostic build only; it halts so the pattern can be read.
+
+  Copyright (c) 2026, UniXNU contributors. All rights reserved.
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+
+#include <Library/BaseLib.h>
+#include <Library/DebugLib.h>
+#include <Library/HobLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Protocol/GraphicsOutput.h>
+
+STATIC CONST EFI_GUID  mEntryArgHobGuid = {
+  0xDAEE82E6, 0x8090, 0x4E72, { 0xBF, 0xB9, 0x78, 0xC1, 0x3C, 0xD4, 0xE3, 0x59 }
+};
+
+//
+// Checkpoint colours. The background is the furthest checkpoint reached; the
+// bars repeat the count so a single ambiguous colour cannot be misread.
+//
+#define ONYX_STAGE_GOP        1
+#define ONYX_STAGE_HOB        2
+#define ONYX_STAGE_MAP        3
+#define ONYX_STAGE_HALTED     4
+
+STATIC
+UINT32
+StageColor (
+  IN UINTN  Stage
+  )
+{
+  switch (Stage) {
+    case ONYX_STAGE_GOP:    return 0x00FF8000; // orange: driver ran, GOP usable
+    case ONYX_STAGE_HOB:    return 0x0000FF00; // green : handoff HOB present
+    case ONYX_STAGE_MAP:    return 0x0000FFFF; // cyan  : memory map readable
+    default:                return 0x00FFFFFF; // white : past every checkpoint
+  }
+}
+
+STATIC
+VOID
+Fill (
+  IN EFI_GRAPHICS_OUTPUT_PROTOCOL  *Gop,
+  IN UINTN                         X,
+  IN UINTN                         Y,
+  IN UINTN                         Width,
+  IN UINTN                         Height,
+  IN UINT32                        Color
+  )
+{
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Pixel;
+  EFI_STATUS                     Status;
+
+  Pixel.Blue  = (UINT8)(Color & 0xFF);
+  Pixel.Green = (UINT8)((Color >> 8) & 0xFF);
+  Pixel.Red   = (UINT8)((Color >> 16) & 0xFF);
+  Pixel.Reserved = 0;
+
+  Status = Gop->Blt (
+                  Gop,
+                  &Pixel,
+                  EfiBltVideoFill,
+                  0,
+                  0,
+                  X,
+                  Y,
+                  Width,
+                  Height,
+                  0
+                  );
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "ONYX: Blt fill failed: %r\n", Status));
+  }
+}
+
+EFI_STATUS
+EFIAPI
+OnyxBringupReportEntry (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS                    Status;
+  EFI_GRAPHICS_OUTPUT_PROTOCOL  *Gop;
+  UINTN                         Stage;
+  UINTN                         Width;
+  UINTN                         Height;
+  UINTN                         Index;
+  UINTN                         BarWidth;
+  UINTN                         BarGap;
+  VOID                          *Handoff;
+
+  Status = gBS->LocateProtocol (&gEfiGraphicsOutputProtocolGuid, NULL, (VOID **)&Gop);
+  if (EFI_ERROR (Status) || (Gop == NULL) || (Gop->Mode == NULL) || (Gop->Mode->Info == NULL)) {
+    // Nothing can be drawn; leaving the panel alone keeps this case distinguishable
+    // from a painted one.
+    CpuDeadLoop ();
+    return EFI_SUCCESS;
+  }
+
+  Stage  = ONYX_STAGE_GOP;
+  Width  = Gop->Mode->Info->HorizontalResolution;
+  Height = Gop->Mode->Info->VerticalResolution;
+
+  Handoff = GetFirstGuidHob (&mEntryArgHobGuid);
+  if (Handoff != NULL) {
+    Stage = ONYX_STAGE_HOB;
+  }
+
+  //
+  // A successful GetMemoryMap proves the DXE core is fully live, which the HOB
+  // lookup alone does not.
+  //
+  {
+    UINTN                      Size = 0;
+    UINTN                      Key;
+    UINTN                      DescriptorSize;
+    UINT32                     Version;
+    EFI_MEMORY_DESCRIPTOR      *Map;
+    EFI_STATUS                 MapStatus;
+
+    MapStatus = gBS->GetMemoryMap (&Size, NULL, &Key, &DescriptorSize, &Version);
+    if (MapStatus == EFI_BUFFER_TOO_SMALL) {
+      Size += DescriptorSize * 4;
+      Map   = AllocatePool (Size);
+      if ((Map != NULL) &&
+          !EFI_ERROR (gBS->GetMemoryMap (&Size, Map, &Key, &DescriptorSize, &Version)))
+      {
+        Stage = ONYX_STAGE_MAP;
+      }
+
+      if (Map != NULL) {
+        FreePool (Map);
+      }
+    }
+  }
+
+  Fill (Gop, 0, 0, Width, Height, StageColor (Stage));
+
+  //
+  // One bar per checkpoint: width is a tenth of the panel, counted from the top
+  // left so the bar count is readable even at an angle.
+  //
+  BarWidth = Width / 12;
+  BarGap   = BarWidth / 2;
+  for (Index = 0; Index < Stage; Index++) {
+    Fill (
+      Gop,
+      Index * (BarWidth + BarGap) + BarGap,
+      BarGap,
+      BarWidth,
+      Height / 4,
+      0x00000000
+      );
+  }
+
+  DEBUG ((DEBUG_INFO, "ONYX: bring-up stage %Lu reached\n", (UINT64)Stage));
+  CpuDeadLoop ();
+  return EFI_SUCCESS;
+}
