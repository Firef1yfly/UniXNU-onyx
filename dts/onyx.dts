		mem_dump {
			compatible = "qcom,mem-dump";
			memory-region = <0x25f>;

			static_dump {
				qcom,static-mem-dump;

				c0_context {
					qcom,dump-size = <0x800>;
					qcom,dump-id = <0x00>;
				};

				c100_context {
					qcom,dump-size = <0x800>;
					qcom,dump-id = <0x01>;
				};

				c200_context {
					qcom,dump-size = <0x800>;
					qcom,dump-id = <0x02>;
				};

				c300_context {
					qcom,dump-size = <0x800>;
					qcom,dump-id = <0x03>;
				};

				c400_context {
					qcom,dump-size = <0x800>;
