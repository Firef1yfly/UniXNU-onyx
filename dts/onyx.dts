					qcom,rx_swr_ch_map = <0x00 0x0e 0x01 0x00 0x0e 0x00 0x0f 0x02 0x00 0x0f 0x01 0x12 0x01 0x00 0x12 0x02 0x10 0x01 0x00 0x10 0x02 0x11 0x02 0x00 0x11 0x03 0x13 0x01 0x00 0x13 0x04 0x14 0x01 0x00 0x14 0x04 0x15 0x02 0x00 0x15>;
					qcom,tx_swr_ch_map = <0x00 0x1e 0x01 0x00 0x2e 0x01 0x1f 0x01 0x00 0x2f 0x02 0x20 0x01 0x00 0x30 0x03 0x22 0x04 0x00 0x32 0x03 0x23 0x08 0x00 0x33 0x03 0x1d 0x04 0x00 0x34 0x04 0x24 0x01 0x00 0x34 0x04 0x25 0x02 0x00 0x35 0x04 0x26 0x03 0x00 0x36 0x04 0x27 0x04 0x00 0x37>;
					qcom,swr-tx-port-params = <0x01 0x00 0x01 0x01 0x00 0x01 0x01 0x00 0x00 0x01 0x01 0x00 0x01 0x00 0x01 0x00 0x00 0x01 0x02 0x00 0x01 0x00 0x02 0x00 0x01 0x00 0x01 0x00 0x01 0x00 0x01 0x00>;
					qcom,wcd-rst-gpio-node = <0x692>;
					qcom,rx-slave = <0x695>;
					qcom,tx-slave = <0x696>;
					cdc-vdd-rxtx-supply = <0x288>;
					qcom,cdc-vdd-rxtx-voltage = <0x1b7740 0x1b7740>;
					qcom,cdc-vdd-rxtx-current = <0x7530>;
					qcom,cdc-vdd-rxtx-lpm-supported = <0x01>;
					cdc-vdd-io-supply = <0x327>;
					qcom,cdc-vdd-io-voltage = <0x124f80 0x124f80>;
					qcom,cdc-vdd-io-current = <0x4e20>;
					qcom,cdc-vdd-io-lpm-supported = <0x01>;
					cdc-vdd-buck-supply = <0x288>;
					qcom,cdc-vdd-buck-voltage = <0x1b7740 0x1b7740>;
					qcom,cdc-vdd-buck-current = <0x9eb10>;
					qcom,cdc-vdd-buck-lpm-supported = <0x01>;
					cdc-vdd-mic-bias-supply = <0x337>;
					qcom,cdc-vdd-mic-bias-voltage = "", "2K", "", "2K";
					qcom,cdc-vdd-mic-bias-current = <0x9c77>;
					qcom,cdc-micbias1-mv = <0xabe>;
					qcom,cdc-micbias2-mv = <0xabe>;
					qcom,cdc-micbias3-mv = <0xabe>;
					qcom,cdc-static-supplies = "cdc-vdd-rxtx", "cdc-vdd-io";
					qcom,cdc-on-demand-supplies = "cdc-vdd-buck";
