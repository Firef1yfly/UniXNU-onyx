					phandle = <0x2e9>;

					conn_therm2 {

						conn_therm2_default {
							phandle = <0x5e8>;
							bias-high-impedance;
							pins = "gpio7";
						};
					};

					xo_therm {

						xo_therm_default {
							phandle = <0x5e7>;
							bias-high-impedance;
							pins = "gpio10";
						};
