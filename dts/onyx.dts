							power-source = <0x00>;
							output-enable;
							function = "normal";
							pins = "gpio11";
						};
					};

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
