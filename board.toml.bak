schema_version = 2

[board]
example = false
name = "onyx"
soc = "SM8735"
soc_source = "sm8735"
os_profile = "ios-17.7.11-21H461"
description = "Redmi Turbo 4 Pro"
kit = "onyx"

[components]
include = ["ArmDTPlatform", "ArmCpu", "SoftwareAES", "XnuPrelink", "DarwinBoot","RamBlock"]

[kernel]
defconfig = "example_defconfig"
config_fragments = ["arch:configs/common.config", "soc:configs/sm8735.config", "os:configs/ios.config"]
patch_series = ["arch:patches/xnu/series", "soc:patches/xnu/series", "os:patches/xnu/series", "device:patches/xnu/series"]

[device_tree]
source = "device:dts/onyx.dts"
include_dirs = ["soc:dts"]

[firmware]
config = "onyx"
dsc = "Platforms/Xiaomi/onyxPkg/onyx.dsc"
fd = "Build/onyxPkg/{target}_CLANGPDB/FV/SILICIUM_UEFI.fd"
packages = [
  "{uefi}",
  "{uefi}/Platforms/Xiaomi",
  "{uefi}/Common/Mu",
  "{uefi}/Common/Mu_OEM_Sample",
  "{uefi}/Mu_Basecore",
  "{uefi}/Silicon/Qualcomm",
  "{uefi}/Silicon/Silicium",
  "{uefi}/Silicium-ACPI",
  "{uefi}/Silicium-ACPI/Platforms/Xiaomi",
  "{uefi}/Silicium-ACPI/Silicon/Qualcomm",
  "{tree}/package",
  "{tree}/drivers/DarwinBoot",
  "{edk2}",
]

[bootimg]
# dtb = "build/onyx/onyx.dtb"

[firmware.defines]
DEVICE_MODEL = "onyx"
ENABLE_SECUREBOOT = "0"

[payload]
volume = "ONYX"
size_mib = 192
loader = "firmware"
title = "UniXNU"
kernel_args = ["-v", "serial=3"]

[package]
unixnu = "../UniXNU"

[package.defconfig]
"ios-17.7.11-21H461" = "example_defconfig"

[payload.adt]
chip_id = "207"
unique_chip_id = "0x1234567890abcdef"

# 定义 UEFI 启动菜单
[unixnu_toml]

# 定义默认启动项
[unixnu_toml.boot]
default = "xnu"

# 定义驱动加载
[[unixnu_toml.driver]]
path = "Drivers/DarwinBoot.efi"

# 定义内核启动项
[[unixnu_toml.entry]]
id = "xnu"
title = "UniXNU (XNU)"
loader = "DarwinBoot" # 与上面的驱动对应
